# Gradle build outputs
.gradle/
**/build/
bin/
tmp-compile/
out/

# Compiled classes (never commit build artifacts)
*.class

# Ignore Gradle GUI config
gradle-app.setting

# Avoid ignoring Gradle wrapper jar file (.jar files are usually ignored)
!gradle-wrapper.jar

# Avoid ignoring Gradle wrapper properties
!gradle-wrapper.properties

# Cache of project
.gradletasknamecache

# Local Gradle overrides at repo root only (personal proxies, signing creds).
# Scoped with a leading slash so project-level gradle.properties files
# in subdirectories stay tracked.
/gradle.properties

# Eclipse
.project
.classpath

# IntelliJ IDEA
.idea/
*.iml

# VS Code
.vscode/

# macOS / Windows
.DS_Store
Thumbs.db

# Logs and editor backups
*.log
*.orig
*~
/.vscode
